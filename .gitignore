# ===== 大目录：绝对不能进版本库 =====
# Maven 本地仓库（95M）
cangku/
# 前端依赖（146M）
node_modules/
# 构建产物
target/
dist/
dist-ssr/

# ===== IDE =====
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json

# ===== 日志与临时文件 =====
*.log
logs/
*.local

# Python 字节码（跑 scripts/benchmark.py 会生成）
__pycache__/
*.pyc

# ===== 数据库快照 =====
# 含真实数据与测试账号密码哈希，属于运行时数据而非源码，不进版本库
db/*.sql

# ===== 本地配置（数据库口令、JWT 密钥）=====
# 提交其上模板 application-local.yml.example，真实值留在这份文件里
application-local.yml

# ===== 求职材料（个人资料，不属于源码，公开仓库里不要出现）=====
docs/简历*
简历*

# ===== AI 工具工作目录（项目记忆、会话数据，不属于源码）=====
.workbuddy/

# ===== 系统 =====
.DS_Store
Thumbs.db
