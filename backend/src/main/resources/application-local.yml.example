# 使用方式：复制本文件为同目录下的 application-local.yml，填入真实值。
#   cp application-local.yml.example application-local.yml
# application-local.yml 已被 .gitignore 排除，不会进入版本库。
# 本文件（.example）是要提交的，里面不能出现任何真实口令。
spring:
  datasource:
    # 数据库地址/账号若与 application.yml 里的默认值一致，无需重复写，只填 password 即可
    # username: mall
    password: 在这里填数据库密码

jwt:
  # HS256 要求密钥至少 32 字节（256 bit），否则 jjwt 会直接抛 WeakKeyException。
  # 生成一个：openssl rand -base64 48
  secret: 在这里填至少32字节的随机字符串
